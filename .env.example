# =======================================================
# CampusFind - Environment Configuration Template
# =======================================================
# Keep real credentials in the ignored .env file, never in source control.

# Docker Compose PostgreSQL configuration.
# Use a unique, strong password for any deployment exposed to a network.
DATABASE_URL=postgresql://myapp_user:change-this-password@postgres:5432/myapp
POSTGRES_PASSWORD=change-this-password

# Optional application HTTP port (defaults to 80)
# APP_PORT=80

# Optional PostgreSQL connection pool size
# PG_POOL_MAX=10

# AWS Deployment Region
VITE_AWS_REGION=us-east-1

# API Gateway Endpoint (Deployed HTTP API URL)
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=http://localhost:3001

# S3 Image Upload & Storage Configuration
VITE_S3_BUCKET_NAME=campusfind-item-images
VITE_MAX_IMAGE_SIZE_MB=5

# Amazon Cognito Configuration (for Admin Portal Authentication)
VITE_COGNITO_USER_POOL_ID=us-east-1_exampleId
VITE_COGNITO_CLIENT_ID=exampleAppClientId1234567

# Campus Branding
VITE_CAMPUS_NAME="Metropolitan University"
VITE_APP_NAME="CampusFind"
VITE_APP_TAGLINE="Lost something? Let's find it."
